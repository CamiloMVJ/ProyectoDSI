# El proxy de Vite envía /api al backend local en el puerto 3000.
VITE_API_URL=/api

# Si activas Storage, configura la URL y la clave pública para subir archivos desde el navegador.
# Usa la URL y la clave publishable del mismo proyecto configurado en el backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
