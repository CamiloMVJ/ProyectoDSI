# Servidor y orígenes permitidos por CORS. localhost:5173 ya está permitido.
PORT=3000
FRONTEND_URL1=
FRONTEND_URL2=

# Base de datos PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Usa un secreto largo y aleatorio para firmar los tokens de la aplicación.
JWT_SECRET=

# Storage es opt-in; sin política explícita todas sus operaciones están deshabilitadas.
SUPABASE_STORAGE_ENABLED=false
# Si activas Storage, configura estas tres variables con el mismo proyecto de Supabase.
# SUPABASE_RECEIPT_SECRET debe tener al menos 32 caracteres.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_RECEIPT_SECRET=
SUPABASE_BUCKET_IMAGES=imagenes-publicas
SUPABASE_BUCKET_DOCUMENTS=documentos-privados
# Bucket privado adicional para validar WebP antes de publicarlo.
SUPABASE_BUCKET_STAGING=
SUPABASE_IMAGE_MAX_BYTES=2097152
SUPABASE_DOCUMENT_MAX_BYTES=10485760
# Uno de: Usuario, Propietario, Administrador. Vacío = ningún acceso.
SUPABASE_STORAGE_TEST_ROLE=
# Limpieza: modo simulación por defecto.
SUPABASE_CLEANUP_APPLY=false
SUPABASE_STORAGE_EPOCH=
